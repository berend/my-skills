#!/bin/bash
set -euo pipefail

MAX_ISSUES=0
ISSUES_DIR="./.plans/ISSUES"
COMPLETED_COUNT=0
TOTAL_INPUT_TOKENS=0
TOTAL_OUTPUT_TOKENS=0
TOTAL_SECONDS=0

format_duration() {
    local seconds=$1
    if [[ $seconds -ge 3600 ]]; then
        printf "%dh %dm %ds" $((seconds/3600)) $((seconds%3600/60)) $((seconds%60))
    elif [[ $seconds -ge 60 ]]; then
        printf "%dm %ds" $((seconds/60)) $((seconds%60))
    else
        printf "%ds" $seconds
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        *)
            MAX_ISSUES="$1"
            shift
            ;;
    esac
done

if [[ ! -d "$ISSUES_DIR" ]]; then
    echo "Error: Issues directory $ISSUES_DIR does not exist"
    exit 1
fi

while true; do
    ISSUE_FILE=$(find "$ISSUES_DIR" -maxdepth 1 -type f -name "*.md" 2>/dev/null | sort | head -n 1)

    if [[ -z "$ISSUE_FILE" ]]; then
        echo "All issues completed!"
        break
    fi

    ISSUE_NAME=$(basename "$ISSUE_FILE")
    echo "=== Working on: $ISSUE_NAME ==="

    PROMPT="You are working through a queue of implementation issues.

Your current task is defined in: $ISSUE_FILE

Instructions:
1. Read the issue file carefully
2. Implement the required changes
3. Make sure linters and tests pass
4. Create ONE git commit with a meaningful message describing what you did
5. Exit with code 0 when done

Do NOT delete the issue file — the orchestrator handles cleanup."

    TMPFILE=$(mktemp)
    trap "rm -f $TMPFILE" EXIT
    START_TIME=$(date +%s)

    claude \
        --verbose \
        --print \
        --output-format stream-json \
        -p "$PROMPT" \
        | grep --line-buffered '^{' \
        | tee "$TMPFILE" \
        | jq --unbuffered -rj 'select(.type == "assistant" and .message.content[]?.text?) | .message.content[] | select(.type == "text") | .text // empty'

    END_TIME=$(date +%s)
    ISSUE_SECONDS=$((END_TIME - START_TIME))
    TOTAL_SECONDS=$((TOTAL_SECONDS + ISSUE_SECONDS))
    ISSUE_DURATION=$(format_duration $ISSUE_SECONDS)

    INPUT_TOKENS=$(cat "$TMPFILE" | grep '^{' | jq -s '[.[] | select(.type == "result") | .usage.input_tokens // 0] | add // 0')
    OUTPUT_TOKENS=$(cat "$TMPFILE" | grep '^{' | jq -s '[.[] | select(.type == "result") | .usage.output_tokens // 0] | add // 0')
    TOTAL_INPUT_TOKENS=$((TOTAL_INPUT_TOKENS + INPUT_TOKENS))
    TOTAL_OUTPUT_TOKENS=$((TOTAL_OUTPUT_TOKENS + OUTPUT_TOKENS))

    COMPLETED_COUNT=$((COMPLETED_COUNT + 1))
    rm -f "$ISSUE_FILE"
    echo ""
    echo "=== Completed issue #$COMPLETED_COUNT: $ISSUE_NAME ==="
    echo "=== Tokens in=$INPUT_TOKENS out=$OUTPUT_TOKENS, time=$ISSUE_DURATION ==="

    REMAINING=$(find "$ISSUES_DIR" -maxdepth 1 -type f -name "*.md" 2>/dev/null | wc -l)
    if [[ "$REMAINING" -eq 0 ]]; then
        echo "All issues completed!"
        break
    fi

    if [[ "$MAX_ISSUES" -gt 0 && "$COMPLETED_COUNT" -ge "$MAX_ISSUES" ]]; then
        echo "Reached maximum issue limit ($MAX_ISSUES). Stopping."
        break
    fi
done

echo ""
echo "=== Ralph completed ==="
echo "Total issues tackled: $COMPLETED_COUNT"
echo "Total tokens: input=$TOTAL_INPUT_TOKENS, output=$TOTAL_OUTPUT_TOKENS"
echo "Total time: $(format_duration $TOTAL_SECONDS)". 